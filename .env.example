# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PostgreSQL / Cloud SQL Runtime Variables (injected automatically in AI Studio Cloud SQL runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Comma-separated admin emails allowed to access /api/admin/* and /admin dashboard
ADMIN_EMAILS=""

# Optional Stripe integration for online card payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional transactional email provider (e.g., Resend) for order confirmation emails
RESEND_API_KEY=""
